
@{
    ViewBag.Title = "Thanh toán";
}


<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/categories_styles.css">
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/categories_responsive.css">

<<div class="container product_section_container">
    <!-- Breadcrumbs -->
    <div class="row">
        <div class="col-12">
            <div class="breadcrumbs d-flex flex-row align-items-center">
                <ul class="mb-0">
                    <li><a href="index.html">Home</a></li>
                    <li class="active"><a href="/"><i class="fa fa-angle-right" aria-hidden="true"></i> Giỏ hàng</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Nội dung giỏ hàng -->
    <div class="row">
        <div class="col-md-12 text-center">
            <h1>Thanh toán</h1>
            <p>Bạn hãy kiểm tra lại thông tin đơn hàng!</p>
        </div>
    </div>
    <hr />
    @if (ViewBag.CheckCart != null)
    {
        <div class="row">
            <div class="col-md-9">
                <h3 class="mb-3">Thông tin khách hàng</h3>

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ tên khách hàng</label>
                    <input type="text" name="CustomerName" class="form-control rounded-3" placeholder="Nhập họ tên" autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Số điện thoại</label>
                    <input type="text" name="Phone" class="form-control rounded-3" placeholder="Nhập số điện thoại" autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ</label>
                    <input type="text" name="Address" class="form-control rounded-3" placeholder="Nhập địa chỉ" autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input type="email" name="Email" class="form-control rounded-3" placeholder="Nhập email" autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Hình thức thanh toán</label>
                    <select class="form-control" name="PaymentMethod">
                        <option value="1" selected>COD</option>
                        <option value="2">Chuyển khoản</option>
                    </select>
                </div>

                <div class="form-group">
                    <button type="button" class="btn btn-block btn-success">Đặt hàng</button>
                </div>
            </div>


            <div class="col-md-3">
                @Html.Action("Partial_Item_Payment", "ShoppingCart")

            </div>
        </div>

    }
else
            {
                <div>
                    Bạn chưa có sản phẩm nào!!! Vui lòng quay lại trang <a href="/san-pham">sản phẩm</a> để mua hàng.
                </div>
            }


</div>

@section scripts{
    <script src="~/Content/assets/js/categories_custom.js"></script>
}


